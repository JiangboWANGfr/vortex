#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ROOT_DIR=$(realpath "$SCRIPT_DIR/..")

show_usage() {
    cat <<EOF
Vortex AES Crypto Experiment Runner

Usage:
  $0 [options]

Options:
  --driver=<simx|rtlsim|de10pro>    Backend driver (default: simx)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE)
  --op-types=<list>                 Comma-separated AES op ids (default: 0,1,2,3,4,5,6,7)
  --blocks=<n>                      Blocks per hardware task (default: 8192)
  --results=<path>                  TSV output path (default: results.tsv)
  --log-dir=<path>                  Run log directory (default: crypto-exp-logs)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

AES op ids:
  0 ecb-enc, 1 ecb-dec, 2 cbc-enc, 3 cbc-dec,
  4 ctr-enc, 5 ctr-dec, 6 key-enc, 7 key-dec

Supported CRYPTO_ACCEL_MODE values in this tree:
  NATIVE, SOFTWARE, TABLE, TABLE_MONOTABLE

Example:
  $0 --driver=simx --accel-modes=NATIVE --op-types=4 --blocks=16 --fd-disable
  $0 --driver=simx --accel-modes=NATIVE,SOFTWARE,TABLE,TABLE_MONOTABLE --op-types=0,1,2,3,4,5,6,7 --blocks=8192 --fd-disable --results=results.tsv --log-dir=crypto-exp-logs

EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

run_cmd() {
    echo "+ $*"
    "$@"
}

format_number() {
    local value="$1"
    if [[ -z "$value" ]]; then
        printf ''
        return
    fi
    printf '%s' "$value" | perl -pe 's/(?<=\d)(?=(?:\d{3})+(?!\d))/,/g'
}

normalize_number() {
    local value="$1"
    printf '%s' "$value" | tr -d ','
}

join_flags() {
    local result=()
    if [[ "$EXT_F_DISABLE" -eq 1 ]]; then
        result+=("EXT_F_DISABLE=1")
    fi
    if [[ "$EXT_D_DISABLE" -eq 1 ]]; then
        result+=("EXT_D_DISABLE=1")
    fi
    printf '%s\n' "${result[@]}"
}

op_name() {
    case "$1" in
        0) echo "ecb-enc" ;;
        1) echo "ecb-dec" ;;
        2) echo "cbc-enc" ;;
        3) echo "cbc-dec" ;;
        4) echo "ctr-enc" ;;
        5) echo "ctr-dec" ;;
        6) echo "key-enc" ;;
        7) echo "key-dec" ;;
        *) die "unsupported AES op type: $1" ;;
    esac
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE|TABLE|TABLE_MONOTABLE)
            ;;
        *)
            die "unsupported CRYPTO_ACCEL_MODE=$1; supported: NATIVE SOFTWARE TABLE TABLE_MONOTABLE"
            ;;
    esac
}

build_driver_runtime() {
    case "$DRIVER" in
        simx)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd env CCACHE_DISABLE=1 make -C "$ROOT_DIR/runtime/simx" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        rtlsim)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd make -C "$ROOT_DIR/runtime/rtlsim" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        de10pro)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd make -C "$ROOT_DIR/runtime/de10pro" clean all
            export TERASIC_PCIE_SO_PATH="${TERASIC_PCIE_SO_PATH:-$ROOT_DIR/../PCIe_SW_KIT/PCIe_DDR4/32G/terasic_pcie_qsys.so}"
            export DE10PRO_VX_TIMEOUT_MS="${DE10PRO_VX_TIMEOUT_MS:-5000}"
            export DE10PRO_VX_VERBOSE_STATUS="${DE10PRO_VX_VERBOSE_STATUS:-1}"
            export DE10PRO_VX_BAR="${DE10PRO_VX_BAR:-4}"
            export DE10PRO_VX_MMIO_BASE="${DE10PRO_VX_MMIO_BASE:-0x4001000}"
            export DE10PRO_VX_STAGING_ADDR="${DE10PRO_VX_STAGING_ADDR:-0x800000000}"
            export DE10PRO_VX_STAGING_SIZE="${DE10PRO_VX_STAGING_SIZE:-0x200000}"
            ;;
        *)
            die "unsupported driver: $DRIVER"
            ;;
    esac
}

extract_field() {
    local pattern="$1"
    local file="$2"
    grep "^AES256_BENCH: .*${pattern}=" "$file" | tail -n 1 | sed -nE "s/.*${pattern}=([0-9,]+).*/\\1/p" | tr -d ',' || true
}

extract_perf() {
    local file="$1"
    local line
    line=$(grep 'PERF: instrs=' "$file" | tail -n 1 || true)
    if [[ -z "$line" ]]; then
        printf '\t\t'
        return
    fi
    printf '%s' "$line" | sed -E 's/.*instrs=([0-9,]+), cycles=([0-9,]+), IPC=([0-9.]+).*/\1\t\2\t\3/' | tr -d ','
}

main() {
    DRIVER="simx"
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    BLOCKS="8192"
    RESULTS="results.tsv"
    LOG_DIR="crypto-exp-logs"
    accel_mode_list="NATIVE"
    op_type_list="0,1,2,3,4,5,6,7"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver=*)
                DRIVER="${1#*=}"
                ;;
            --accel-modes=*)
                accel_mode_list="${1#*=}"
                ;;
            --op-types=*)
                op_type_list="${1#*=}"
                ;;
            --blocks=*)
                BLOCKS="${1#*=}"
                ;;
            --results=*)
                RESULTS="${1#*=}"
                ;;
            --log-dir=*)
                LOG_DIR="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    if [[ ! "$BLOCKS" =~ ^[0-9]+$ ]] || [[ "$BLOCKS" -eq 0 ]]; then
        die "--blocks must be a positive integer"
    fi

    IFS=',' read -r -a ACCEL_MODES <<< "$accel_mode_list"
    IFS=',' read -r -a OP_TYPES <<< "$op_type_list"

    local mode
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
    done

    local op
    for op in "${OP_TYPES[@]}"; do
        op_name "$op" > /dev/null
    done

    if [[ ! -f "$ROOT_DIR/config.mk" ]]; then
        die "config.mk not found under $ROOT_DIR"
    fi

    XLEN=$(sed -n 's/^XLEN[[:space:]]*?=[[:space:]]*//p' "$ROOT_DIR/config.mk" | head -n1 | tr -d '[:space:]')
    if [[ -z "$XLEN" ]]; then
        die "failed to determine XLEN from $ROOT_DIR/config.mk"
    fi
    if [[ -z "$STARTUP_ADDR" ]]; then
        if [[ "$XLEN" == "64" ]]; then
            STARTUP_ADDR="0x180000000"
        else
            STARTUP_ADDR="0x80000000"
        fi
    fi

    if [[ -f "$ROOT_DIR/ci/toolchain_env.sh" ]]; then
        # shellcheck disable=SC1091
        source "$ROOT_DIR/ci/toolchain_env.sh"
    fi

    mkdir -p "$LOG_DIR"

    echo "ROOT_DIR=$ROOT_DIR"
    echo "XLEN=$XLEN"
    echo "DRIVER=$DRIVER"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "OP_TYPES=${OP_TYPES[*]}"
    echo "BLOCKS=$BLOCKS"
    echo "RESULTS=$RESULTS"

    run_cmd make -C "$ROOT_DIR/hw" config

    local kernel_args=("make" "-C" "$ROOT_DIR/kernel" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && kernel_args+=("$flag")
    done < <(join_flags)
    run_cmd "${kernel_args[@]}"

    build_driver_runtime

    printf 'algo\top_type\top_name\taccel_mode\tdriver\tblocks_per_task\ttotal_blocks\ttotal_bytes\tinstrs\tcycles\tIPC\tstatus\tlog\n' > "$RESULTS"

    local app_dir="$ROOT_DIR/tests/regression/aes256_bench"
    local failures=0
    for mode in "${ACCEL_MODES[@]}"; do
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "CRYPTO_ACCEL_MODE=$mode")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        for op in "${OP_TYPES[@]}"; do
            local opname
            local safe_mode
            local log_file
            local status
            local total_blocks
            local total_bytes
            local perf
            local perf_instrs
            local perf_cycles
            local perf_ipc
            opname=$(op_name "$op")
            safe_mode=${mode//,/+}
            log_file="$LOG_DIR/aes256-${safe_mode}-op${op}.log"

            echo
            echo "== Running aes256_bench op=$opname mode=$mode on $DRIVER =="
            if make -C "$app_dir" "run-$DRIVER" "CRYPTO_ACCEL_MODE=$mode" "OPTS=-n $BLOCKS -t $op" 2>&1 | tee "$log_file"; then
                status="ok"
            else
                status="fail"
                failures=$((failures + 1))
            fi

            total_blocks=$(extract_field "total_blocks" "$log_file")
            total_bytes=$(extract_field "total_bytes" "$log_file")
            perf=$(extract_perf "$log_file")
            IFS=$'\t' read -r perf_instrs perf_cycles perf_ipc <<< "$perf"
            printf 'aes256\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$op" "$opname" "$mode" "$DRIVER" "$(format_number "$(normalize_number "$BLOCKS")")" \
                "$(format_number "$total_blocks")" "$(format_number "$total_bytes")" \
                "$(format_number "$perf_instrs")" "$(format_number "$perf_cycles")" "${perf_ipc:-}" \
                "$status" "$log_file" >> "$RESULTS"
        done
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures AES benchmark run(s) failed; partial results are in $RESULTS"
    fi

    echo "AES crypto experiment results written to $RESULTS"
}

main "$@"
