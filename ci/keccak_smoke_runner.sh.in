#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ROOT_DIR=$(realpath "$SCRIPT_DIR/..")

show_usage() {
    cat <<EOF
Vortex Keccak Smoke Runner

Usage:
  $0 [options]

Options:
  --drivers=<list>                  Comma-separated backends (default: simx,rtlsim)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE,SOFTWARE)
  --short-cases=<n>                 Cases to load from each short-message RSP (default: 16)
  --long-cases=<n>                  Cases to load from each long-message RSP (default: 4)
  --results=<path>                  TSV output path (default: keccak-smoke-results.tsv)
  --log-dir=<path>                  Run log directory (default: keccak-smoke-logs)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

Supported KECCAK_ACCEL_MODE values:
  NATIVE, SOFTWARE

Examples:
  $0 --drivers=simx,rtlsim --accel-modes=NATIVE,SOFTWARE --fd-disable
  $0 --drivers=simx --accel-modes=SOFTWARE --short-cases=32 --long-cases=8 --fd-disable
  $0 --drivers=de10pro --accel-modes=NATIVE --short-cases=16 --long-cases=4 --fd-disable
EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

run_cmd() {
    echo "+ $*"
    "$@"
}

join_flags() {
    local result=()
    if [[ "$EXT_F_DISABLE" -eq 1 ]]; then
        result+=("EXT_F_DISABLE=1")
    fi
    if [[ "$EXT_D_DISABLE" -eq 1 ]]; then
        result+=("EXT_D_DISABLE=1")
    fi
    printf '%s\n' "${result[@]}"
}

validate_driver() {
    case "$1" in
        simx|rtlsim|de10pro)
            ;;
        *)
            die "unsupported driver: $1; supported: simx rtlsim de10pro"
            ;;
    esac
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE)
            ;;
        *)
            die "unsupported KECCAK_ACCEL_MODE=$1; supported: NATIVE SOFTWARE"
            ;;
    esac
}

driver_configs() {
    local need_native="$1"
    if [[ "$need_native" -eq 1 ]]; then
        printf '%s\n' "CONFIGS=-DEXT_KECCAK_ENABLE"
    fi
}

build_driver_runtime() {
    local driver="$1"
    local need_native="$2"
    local args=("make" "-C" "$ROOT_DIR/runtime/stub" "clean" "all")
    run_cmd "${args[@]}"

    args=("make" "-C" "$ROOT_DIR/runtime/$driver" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && args+=("$flag")
    done < <(driver_configs "$need_native")
    case "$driver" in
        simx|rtlsim)
            args=("env" "CCACHE_DISABLE=1" "${args[@]}")
            ;;
        de10pro)
            export TERASIC_PCIE_SO_PATH="${TERASIC_PCIE_SO_PATH:-$ROOT_DIR/../PCIe_SW_KIT/PCIe_DDR4/32G/terasic_pcie_qsys.so}"
            export DE10PRO_VX_TIMEOUT_MS="${DE10PRO_VX_TIMEOUT_MS:-5000}"
            export DE10PRO_VX_VERBOSE_STATUS="${DE10PRO_VX_VERBOSE_STATUS:-1}"
            export DE10PRO_VX_BAR="${DE10PRO_VX_BAR:-4}"
            export DE10PRO_VX_MMIO_BASE="${DE10PRO_VX_MMIO_BASE:-0x4001000}"
            export DE10PRO_VX_STAGING_ADDR="${DE10PRO_VX_STAGING_ADDR:-0x800000000}"
            export DE10PRO_VX_STAGING_SIZE="${DE10PRO_VX_STAGING_SIZE:-0x200000}"
            ;;
    esac
    run_cmd "${args[@]}"
}

main() {
    DRIVER_LIST="simx,rtlsim"
    ACCEL_MODE_LIST="NATIVE,SOFTWARE"
    SHORT_CASES=16
    LONG_CASES=4
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    RESULTS="keccak-smoke-results.tsv"
    LOG_DIR="keccak-smoke-logs"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --drivers=*) DRIVER_LIST="${1#*=}" ;;
            --accel-modes=*) ACCEL_MODE_LIST="${1#*=}" ;;
            --short-cases=*) SHORT_CASES="${1#*=}" ;;
            --long-cases=*) LONG_CASES="${1#*=}" ;;
            --results=*) RESULTS="${1#*=}" ;;
            --log-dir=*) LOG_DIR="${1#*=}" ;;
            --startup-addr=*) STARTUP_ADDR="${1#*=}" ;;
            --ext-f-disable) EXT_F_DISABLE=1 ;;
            --ext-d-disable) EXT_D_DISABLE=1 ;;
            --fd-disable) EXT_F_DISABLE=1; EXT_D_DISABLE=1 ;;
            --debug=*) DEBUG_LEVEL="${1#*=}" ;;
            --help|-h) show_usage; exit 0 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    IFS=',' read -r -a DRIVERS <<< "$DRIVER_LIST"
    IFS=',' read -r -a ACCEL_MODES <<< "$ACCEL_MODE_LIST"

    local driver
    for driver in "${DRIVERS[@]}"; do
        validate_driver "$driver"
    done

    local mode
    local need_native=0
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
        if [[ "$mode" == "NATIVE" ]]; then
            need_native=1
        fi
    done

    XLEN=$(sed -n 's/^XLEN[[:space:]]*?=[[:space:]]*//p' "$ROOT_DIR/config.mk" | head -n1 | tr -d '[:space:]')
    if [[ -z "$STARTUP_ADDR" ]]; then
        if [[ "$XLEN" == "64" ]]; then
            STARTUP_ADDR="0x180000000"
        else
            STARTUP_ADDR="0x80000000"
        fi
    fi

    if [[ -f "$ROOT_DIR/ci/toolchain_env.sh" ]]; then
        # shellcheck disable=SC1091
        source "$ROOT_DIR/ci/toolchain_env.sh"
    fi

    mkdir -p "$LOG_DIR"

    run_cmd make -C "$ROOT_DIR/hw" config

    local kernel_args=("make" "-C" "$ROOT_DIR/kernel" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && kernel_args+=("$flag")
    done < <(join_flags)
    run_cmd "${kernel_args[@]}"

    for driver in "${DRIVERS[@]}"; do
        build_driver_runtime "$driver" "$need_native"
    done

    printf 'algo\taccel_mode\tdriver\tstatus\tlog\n' > "$RESULTS"

    local app_dir="$ROOT_DIR/tests/regression/keccak_smoke"
    local failures=0
    for mode in "${ACCEL_MODES[@]}"; do
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "KECCAK_ACCEL_MODE=$mode")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        for driver in "${DRIVERS[@]}"; do
            local log_file="$LOG_DIR/keccak-${mode}-${driver}.log"
            local status
            if env CCACHE_DISABLE=1 make -C "$app_dir" "run-$driver" "KECCAK_ACCEL_MODE=$mode" "OPTS=-n $SHORT_CASES -l $LONG_CASES" >"$log_file" 2>&1; then
                status="PASS"
            else
                status="FAIL"
                failures=$((failures + 1))
            fi
            printf 'keccak\t%s\t%s\t%s\t%s\n' "$mode" "$driver" "$status" "$log_file" >> "$RESULTS"
        done
    done

    [[ "$failures" -eq 0 ]]
}

main "$@"
