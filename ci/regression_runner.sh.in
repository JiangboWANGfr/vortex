set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ROOT_DIR=$(realpath "$SCRIPT_DIR/..")

show_usage() {
    cat <<EOF
Vortex Regression Runner

Usage:
  $0 [options]

Options:
  --driver=<simx|rtlsim|de10pro>    Backend driver (default: simx)
  --apps=<list|all>                 Comma-separated app list (default: all)
  --opts=<args>                     Override runtime args for every app
  --startup-addr=<hex>              Kernel startup address (default: 0x80000000)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

Supported apps:
  basic, demo, aes_smoke, aes256

Examples:
  $0 --driver=simx --apps=all --fd-disable
  $0 --driver=de10pro --apps=basic,demo --fd-disable
  $0 --driver=rtlsim --apps=aes_smoke --fd-disable --debug=3
EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

run_cmd() {
    echo "+ $*"
    "$@"
}

join_flags() {
    local result=()
    if [[ "$EXT_F_DISABLE" -eq 1 ]]; then
        result+=("EXT_F_DISABLE=1")
    fi
    if [[ "$EXT_D_DISABLE" -eq 1 ]]; then
        result+=("EXT_D_DISABLE=1")
    fi
    printf '%s\n' "${result[@]}"
}

default_app_opts() {
    case "$1" in
        basic)
            echo "-t1 -n128"
            ;;
        demo)
            echo "-n1"
            ;;
        aes_smoke|aes256)
            echo ""
            ;;
        *)
            die "unsupported app: $1"
            ;;
    esac
}

validate_apps() {
    local app
    for app in "${APPS[@]}"; do
        case "$app" in
            basic|demo|aes_smoke|aes256)
                ;;
            *)
                die "unsupported app: $app"
                ;;
        esac
    done
}

build_driver_runtime() {
    case "$DRIVER" in
        simx)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd env CCACHE_DISABLE=1 make -C "$ROOT_DIR/runtime/simx" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        rtlsim)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd make -C "$ROOT_DIR/runtime/rtlsim" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        de10pro)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd make -C "$ROOT_DIR/runtime/de10pro" clean all
            export TERASIC_PCIE_SO_PATH="${TERASIC_PCIE_SO_PATH:-$ROOT_DIR/../PCIe_SW_KIT/PCIe_DDR4/32G/terasic_pcie_qsys.so}"
            export DE10PRO_VX_TIMEOUT_MS="${DE10PRO_VX_TIMEOUT_MS:-5000}"
            export DE10PRO_VX_VERBOSE_STATUS="${DE10PRO_VX_VERBOSE_STATUS:-1}"
            export DE10PRO_VX_BAR="${DE10PRO_VX_BAR:-4}"
            export DE10PRO_VX_MMIO_BASE="${DE10PRO_VX_MMIO_BASE:-0x4001000}"
            export DE10PRO_VX_STAGING_ADDR="${DE10PRO_VX_STAGING_ADDR:-0x800000000}"
            export DE10PRO_VX_STAGING_SIZE="${DE10PRO_VX_STAGING_SIZE:-0x200000}"
            ;;
        *)
            die "unsupported driver: $DRIVER"
            ;;
    esac
}

main() {
    DRIVER="simx"
    STARTUP_ADDR="0x80000000"
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    OPTS_OVERRIDE=""

    local app_list="all"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver=*)
                DRIVER="${1#*=}"
                ;;
            --apps=*)
                app_list="${1#*=}"
                ;;
            --opts=*)
                OPTS_OVERRIDE="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    if [[ "$app_list" == "all" ]]; then
        APPS=(basic demo aes_smoke aes256)
    else
        IFS=',' read -r -a APPS <<< "$app_list"
    fi
    validate_apps

    if [[ ! -f "$ROOT_DIR/config.mk" ]]; then
        die "config.mk not found under $ROOT_DIR"
    fi

    XLEN=$(sed -n 's/^XLEN[[:space:]]*?=[[:space:]]*//p' "$ROOT_DIR/config.mk" | head -n1 | tr -d '[:space:]')
    if [[ -z "$XLEN" ]]; then
        die "failed to determine XLEN from $ROOT_DIR/config.mk"
    fi

    if [[ -f "$ROOT_DIR/ci/toolchain_env.sh" ]]; then
        # shellcheck disable=SC1091
        source "$ROOT_DIR/ci/toolchain_env.sh"
    fi

    echo "ROOT_DIR=$ROOT_DIR"
    echo "XLEN=$XLEN"
    echo "DRIVER=$DRIVER"
    echo "APPS=${APPS[*]}"
    echo "STARTUP_ADDR=$STARTUP_ADDR"
    echo "EXT_F_DISABLE=$EXT_F_DISABLE"
    echo "EXT_D_DISABLE=$EXT_D_DISABLE"

    run_cmd make -C "$ROOT_DIR/hw" config

    local kernel_args=("make" "-C" "$ROOT_DIR/kernel" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && kernel_args+=("$flag")
    done < <(join_flags)
    run_cmd "${kernel_args[@]}"

    build_driver_runtime

    local failures=0
    local app
    for app in "${APPS[@]}"; do
        local app_dir="$ROOT_DIR/tests/regression/$app"
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        local app_opts
        if [[ -n "$OPTS_OVERRIDE" ]]; then
            app_opts="$OPTS_OVERRIDE"
        else
            app_opts=$(default_app_opts "$app")
        fi

        local run_args=("make" "-C" "$app_dir" "run-$DRIVER")
        if [[ -n "$app_opts" ]]; then
            run_args+=("OPTS=$app_opts")
        fi

        echo
        echo "== Running $app on $DRIVER =="
        if ! "${run_args[@]}"; then
            failures=$((failures + 1))
            echo "FAILED: $app on $DRIVER" >&2
        fi
        echo
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures app(s) failed"
    fi

    echo "All requested apps passed on $DRIVER"
}

main "$@"
