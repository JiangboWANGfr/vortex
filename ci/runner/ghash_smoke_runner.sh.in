#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
if [[ -f "$SCRIPT_DIR/runner_common.sh" ]]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh"
else
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh.in"
fi

show_usage() {
    cat <<EOF
Vortex GHASH Smoke Runner

Runs the GHASH smoke across an accel-mode x variant x driver matrix and
emits a TSV with instrs/cycles/IPC. The same 8 algebraic-identity checks
run in every mode, so SOFTWARE and NATIVE rows are a direct correctness
cross-check of the hardware GHASH PE against the software gold model.

Accel modes:
  SOFTWARE : pure GF(2^128) reference (no hardware GHASH PE)
  NATIVE   : hardware GHASH PE via custom intrinsics; rebuilds the sim
             driver with -DEXT_GHASH_ENABLE and the kernel with
             -DGHASH_NATIVE.

Variants:
  scalar : tests/crypto/aes-gcm/ghash_smoke      (one GHASH chain per warp)
  simt   : tests/crypto/aes-gcm/ghash_simt_smoke  (vx_spawn_threads fan-out)

NOTE: NATIVE + simt is skipped — the GHASH PE holds one {H,Y} state per
warp, so independent per-lane chains would clobber each other. Per-lane
state (warp-level multi-chain) is future work.

Usage:
  $0 [options]

Options:
  --drivers=<list>            Comma-separated backends (default: simx)
                              Supported: simx, rtlsim, de10pro
  --accel-modes=<list>        Comma-separated modes (default: SOFTWARE,NATIVE)
  --variants=<list>           Comma-separated variants (default: scalar,simt)
  --num-tasks=<n>             Tasks for the SIMT variant (default: 64)
  --output-root=<path>        Output root (default: <build>/runner_output)
  --results=<path>            Aggregate TSV (default:
                              <output-root>/ghash_smoke/results/all/results.tsv)
  --log-dir=<path>            Per-run logs (default:
                              <output-root>/ghash_smoke/logs)
  --startup-addr=<hex>        Kernel startup address (default: XLEN-specific)
  --ext-f-disable             Build kernel with EXT_F_DISABLE=1
  --ext-d-disable             Build kernel with EXT_D_DISABLE=1
  --fd-disable                Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>             Debug level passed to simulators (default: 0)
  --help                      Show this help

The prebuilt libvortex.a is typically soft-float (rv64ima); pass --fd-disable
to match it when (re)building the kernel runtime.

Examples:
  $0 --drivers=simx --accel-modes=SOFTWARE,NATIVE --fd-disable
  $0 --drivers=simx,rtlsim --accel-modes=NATIVE --variants=scalar --fd-disable
EOF
}

validate_accel_mode() {
    case "$1" in
        SOFTWARE|NATIVE) ;;
        *) die "unsupported accel mode: $1; supported: SOFTWARE NATIVE" ;;
    esac
}

validate_variant() {
    case "$1" in
        scalar|simt) ;;
        *) die "unsupported variant: $1; supported: scalar simt" ;;
    esac
}

variant_app_dir() {
    case "$1" in
        scalar) echo "$ROOT_DIR/tests/crypto/aes-gcm/ghash_smoke" ;;
        simt)   echo "$ROOT_DIR/tests/crypto/aes-gcm/ghash_simt_smoke" ;;
    esac
}

variant_opts() {
    case "$1" in
        scalar) echo "" ;;
        simt)   echo "-n $NUM_TASKS" ;;
    esac
}

# Pull the aggregate "PERF: instrs=N, cycles=N, IPC=N" line from a run log.
extract_perf() {
    local file="$1"
    local line
    line=$(grep -a '^PERF: instrs=' "$file" | tail -n 1 || true)
    if [[ -z "$line" ]]; then
        printf '\t\t'
        return
    fi
    printf '%s' "$line" \
        | sed -E 's/.*instrs=([0-9,]+), cycles=([0-9,]+), IPC=([0-9.]+).*/\1\t\2\t\3/' \
        | tr -d ','
}

main() {
    RUNNER_NAME="ghash_smoke"
    DRIVER_LIST="simx"
    ACCEL_MODE_LIST="SOFTWARE,NATIVE"
    VARIANT_LIST="scalar,simt"
    NUM_TASKS=64
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    OUTPUT_ROOT="$ROOT_DIR/runner_output"
    RESULTS=""
    LOG_DIR=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --drivers=*)      DRIVER_LIST="${1#*=}" ;;
            --accel-modes=*)  ACCEL_MODE_LIST="${1#*=}" ;;
            --variants=*)     VARIANT_LIST="${1#*=}" ;;
            --num-tasks=*)    NUM_TASKS="${1#*=}" ;;
            --output-root=*)  OUTPUT_ROOT="${1#*=}" ;;
            --results=*)      RESULTS="${1#*=}" ;;
            --log-dir=*)      LOG_DIR="${1#*=}" ;;
            --startup-addr=*) STARTUP_ADDR="${1#*=}" ;;
            --ext-f-disable)  EXT_F_DISABLE=1 ;;
            --ext-d-disable)  EXT_D_DISABLE=1 ;;
            --fd-disable)     EXT_F_DISABLE=1; EXT_D_DISABLE=1 ;;
            --debug=*)        DEBUG_LEVEL="${1#*=}" ;;
            --help|-h)        show_usage; exit 0 ;;
            *)                die "unknown option: $1" ;;
        esac
        shift
    done

    IFS=',' read -r -a DRIVERS     <<< "$DRIVER_LIST"
    IFS=',' read -r -a ACCEL_MODES <<< "$ACCEL_MODE_LIST"
    IFS=',' read -r -a VARIANTS    <<< "$VARIANT_LIST"

    local driver mode variant
    for driver in "${DRIVERS[@]}";      do validate_driver "$driver";      done
    for mode in "${ACCEL_MODES[@]}";    do validate_accel_mode "$mode";    done
    for variant in "${VARIANTS[@]}";    do validate_variant "$variant";    done

    load_xlen
    set_default_startup_addr
    source_toolchain_env
    init_multi_driver_output
    local run_output_dir="$OUTPUT_ROOT/$RUNNER_NAME"

    echo "ROOT_DIR=$ROOT_DIR"
    echo "OUTPUT_ROOT=$OUTPUT_ROOT"
    echo "XLEN=$XLEN"
    echo "DRIVERS=${DRIVERS[*]}"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "VARIANTS=${VARIANTS[*]}"
    echo "NUM_TASKS=$NUM_TASKS"
    echo "RESULTS=$RESULTS"

    run_cmd make -C "$ROOT_DIR/hw" config
    build_kernel

    local header='algo\taccel_mode\tvariant\tdriver\tstatus\tinstrs\tcycles\tIPC\tlog\n'
    printf "$header" > "$RESULTS"
    for driver in "${DRIVERS[@]}"; do
        mkdir -p "$LOG_DIR/$driver" "$run_output_dir/results/$driver"
        printf "$header" > "$run_output_dir/results/$driver/results.tsv"
    done

    local failures=0
    for mode in "${ACCEL_MODES[@]}"; do
        # The hardware GHASH PE is compiled into the simulator only with
        # -DEXT_GHASH_ENABLE, so the driver runtime must be rebuilt per mode.
        local -a driver_cfg=()
        if [[ "$mode" == "NATIVE" ]]; then
            driver_cfg+=("CONFIGS=-DEXT_GHASH_ENABLE")
        fi
        for driver in "${DRIVERS[@]}"; do
            build_driver_runtime_common "$driver" 5000 "${driver_cfg[@]}"
        done

        for variant in "${VARIANTS[@]}"; do
            if [[ "$mode" == "NATIVE" && "$variant" == "simt" ]]; then
                echo "== SKIP ghash mode=NATIVE variant=simt (per-warp state) =="
                continue
            fi

            local app_dir opts
            app_dir=$(variant_app_dir "$variant")
            opts=$(variant_opts "$variant")

            local build_args=("make" "-C" "$app_dir" "clean" "all"
                              "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR")
            # GHASH_ACCEL_MODE is only meaningful for the scalar app's Makefile;
            # the simt app ignores it (software only).
            if [[ "$variant" == "scalar" ]]; then
                build_args+=("GHASH_ACCEL_MODE=$mode")
            fi
            while IFS= read -r flag; do
                [[ -n "$flag" ]] && build_args+=("$flag")
            done < <(join_flags)
            run_cmd "${build_args[@]}"

            for driver in "${DRIVERS[@]}"; do
                local log_file="$LOG_DIR/$driver/ghash-${mode}-${variant}-${driver}.log"
                local status
                echo
                echo "== Running ghash mode=$mode variant=$variant on $driver =="
                if env CCACHE_DISABLE=1 make -C "$app_dir" "run-$driver" \
                        OPTS="$opts" >"$log_file" 2>&1; then
                    status="PASS"
                else
                    status="FAIL"
                    failures=$((failures + 1))
                fi

                local perf instrs cycles ipc
                perf=$(extract_perf "$log_file")
                IFS=$'\t' read -r instrs cycles ipc <<< "$perf"

                local row
                row=$(printf 'ghash\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
                    "$mode" "$variant" "$driver" "$status" \
                    "$instrs" "$cycles" "$ipc" "$log_file")
                printf '%s\n' "$row" >> "$RESULTS"
                printf '%s\n' "$row" >> "$run_output_dir/results/$driver/results.tsv"
            done
        done
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures GHASH smoke run(s) failed; partial results in $RESULTS"
    fi

    echo "GHASH smoke results written to $RESULTS"
}

main "$@"
