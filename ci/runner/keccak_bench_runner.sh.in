#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
if [[ -f "$SCRIPT_DIR/runner_common.sh" ]]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh"
else
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh.in"
fi

show_usage() {
    cat <<EOF
Vortex Keccak Benchmark Runner

Usage:
  $0 [options]

Options:
  --driver=<simx|rtlsim|de10pro>    Backend driver (default: simx)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE)
  --dispatch=<warp|lane>            Work distribution mode compiled into keccak_bench (default: warp)
  --datasets=<list>                 Comma-separated dataset kinds (default: byte-long)
  --messages=<n>                    Messages per hardware task (default: 1)
  --cases=<n>                       Unique vectors loaded from the dataset file (default: 256)
  --output-root=<path>               Output root (default: <build>/runner_output)
  --results=<path>                  TSV output path (default: <output-root>/keccak_bench/results/<driver>/results.tsv)
  --log-dir=<path>                  Run log directory (default: <output-root>/keccak_bench/logs/<driver>)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

Supported KECCAK_ACCEL_MODE values:
  NATIVE, SOFTWARE

Supported dataset kinds:
  byte-short, byte-long, bit-short, bit-long

Examples:
  $0 --driver=simx --accel-modes=NATIVE,SOFTWARE --dispatch=warp --datasets=byte-short,byte-long --messages=2 --cases=64 --fd-disable
  $0 --driver=rtlsim --accel-modes=NATIVE --datasets=byte-short --messages=1 --cases=16 --fd-disable
  $0 --driver=de10pro --accel-modes=NATIVE --dispatch=lane --datasets=byte-long,bit-long --messages=2 --cases=256 --fd-disable
EOF
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE)
            ;;
        *)
            die "unsupported KECCAK_ACCEL_MODE=$1; supported: NATIVE SOFTWARE"
            ;;
    esac
}

validate_dataset() {
    case "$1" in
        byte-short|byte-long|bit-short|bit-long)
            ;;
        *)
            die "unsupported dataset kind: $1"
            ;;
    esac
}

validate_dispatch() {
    case "$1" in
        warp|lane)
            ;;
        *)
            die "unsupported dispatch mode: $1; supported: warp lane"
            ;;
    esac
}

dispatch_make_var() {
    case "$1" in
        warp) printf 'WARP\n' ;;
        lane) printf 'LANE\n' ;;
    esac
}

driver_configs() {
    local need_native="$1"
    if [[ "$need_native" -eq 1 ]]; then
        printf '%s\n' "CONFIGS=-DEXT_KECCAK_ENABLE"
    fi
}

build_driver_runtime() {
    local need_native="$1"
    local args=()
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && args+=("$flag")
    done < <(driver_configs "$need_native")
    build_driver_runtime_common "$DRIVER" 5000 "${args[@]}"
}

extract_field() {
    local pattern="$1"
    local file="$2"
    grep -a "^KECCAK_BENCH: .*${pattern}=" "$file" | tail -n 1 | sed -nE "s/.*${pattern}=([0-9,xa-fA-F-]+).*/\\1/p" | tr -d ',' || true
}

extract_perf() {
    local file="$1"
    local line
    line=$(grep -a 'PERF: instrs=' "$file" | tail -n 1 || true)
    if [[ -z "$line" ]]; then
        printf '\t\t'
        return
    fi
    printf '%s' "$line" | sed -E 's/.*instrs=([0-9,]+), cycles=([0-9,]+), IPC=([0-9.]+).*/\1\t\2\t\3/' | tr -d ','
}

main() {
    RUNNER_NAME="keccak_bench"
    DRIVER="simx"
    DISPATCH="warp"
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    MESSAGES="1"
    CASES="256"
    OUTPUT_ROOT="$ROOT_DIR/runner_output"
    RESULTS=""
    LOG_DIR=""
    accel_mode_list="NATIVE"
    dataset_list="byte-long"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver=*) DRIVER="${1#*=}" ;;
            --accel-modes=*) accel_mode_list="${1#*=}" ;;
            --dispatch=*) DISPATCH="${1#*=}" ;;
            --datasets=*) dataset_list="${1#*=}" ;;
            --messages=*) MESSAGES="${1#*=}" ;;
            --cases=*) CASES="${1#*=}" ;;
            --output-root=*) OUTPUT_ROOT="${1#*=}" ;;
            --results=*) RESULTS="${1#*=}" ;;
            --log-dir=*) LOG_DIR="${1#*=}" ;;
            --startup-addr=*) STARTUP_ADDR="${1#*=}" ;;
            --ext-f-disable) EXT_F_DISABLE=1 ;;
            --ext-d-disable) EXT_D_DISABLE=1 ;;
            --fd-disable) EXT_F_DISABLE=1; EXT_D_DISABLE=1 ;;
            --debug=*) DEBUG_LEVEL="${1#*=}" ;;
            --help|-h) show_usage; exit 0 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    # Parse and validate command-line options before doing any expensive builds.
    validate_dispatch "$DISPATCH"
    local dispatch_make
    dispatch_make=$(dispatch_make_var "$DISPATCH")

    IFS=',' read -r -a ACCEL_MODES <<< "$accel_mode_list"
    IFS=',' read -r -a DATASETS <<< "$dataset_list"

    local need_native=0
    local mode
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
        if [[ "$mode" == "NATIVE" ]]; then
            need_native=1
        fi
    done

    local dataset
    for dataset in "${DATASETS[@]}"; do
        validate_dataset "$dataset"
    done

    # Resolve build configuration, toolchain paths, and runner output folders.
    load_xlen
    set_default_startup_addr
    source_toolchain_env
    init_single_driver_output

    echo "ROOT_DIR=$ROOT_DIR"
    echo "OUTPUT_ROOT=$OUTPUT_ROOT"
    echo "XLEN=$XLEN"
    echo "DRIVER=$DRIVER"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "DISPATCH=$DISPATCH"
    echo "DATASETS=${DATASETS[*]}"
    echo "MESSAGES=$MESSAGES"
    echo "CASES=$CASES"
    echo "RESULTS=$RESULTS"

    # Generate hardware config headers, build the common kernel runtime, then
    # build the selected host/device runtime backend with Keccak native support
    # when any requested mode needs it.
    run_cmd make -C "$ROOT_DIR/hw" config
    build_kernel
    build_driver_runtime "$need_native"

    # Run each accel-mode/dataset pair, collect logs, and defer TSV emission
    # until SOFTWARE baselines are known for cycles_speedup calculation.
    local app_dir="$ROOT_DIR/tests/crypto/keccak/keccak_bench"
    local failures=0

    # rows holds formatted result records in memory. We cannot write rows
    # immediately because NATIVE rows need the matching SOFTWARE cycle count
    # to compute cycles_speedup, and SOFTWARE may appear later in ACCEL_MODES.
    local -a rows=()

    # software_cycles maps one comparable workload to its SOFTWARE cycle count.
    # Key fields are dispatch mode, dataset, driver, messages_per_task, actual
    # dataset cases, and total messages; this prevents cross-dataset speedups.
    declare -A software_cycles=()

    # Build once per acceleration mode because KECCAK_ACCEL_MODE and dispatch
    # mode are compile-time choices for the benchmark binary.
    for mode in "${ACCEL_MODES[@]}"; do
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "KECCAK_ACCEL_MODE=$mode" "KECCAK_BENCH_DISPATCH=$dispatch_make")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        # Reuse the mode-specific binary for each requested dataset. Each
        # dataset gets its own log so vector-set failures are easy to isolate.
        for dataset in "${DATASETS[@]}"; do
            local log_file="$LOG_DIR/keccak-bench-${mode}-${DISPATCH}-${dataset}-${DRIVER}.log"
            local status
            if env CCACHE_DISABLE=1 make -C "$app_dir" "run-$DRIVER" "KECCAK_ACCEL_MODE=$mode" "KECCAK_BENCH_DISPATCH=$dispatch_make" "OPTS=-n $MESSAGES -c $CASES -d $dataset" >"$log_file" 2>&1; then
                status="PASS"
            else
                status="FAIL"
                failures=$((failures + 1))
            fi

            # Pull benchmark dimensions, checksum, and performance summary out
            # of the log. actual_cases can differ from requested CASES when a
            # dataset contains fewer vectors, so use it in the comparison key.
            local actual_cases total_messages total_bits digest_checksum perf instrs cycles ipc row_key
            actual_cases=$(extract_field "dataset_cases" "$log_file")
            total_messages=$(extract_field "total_messages" "$log_file")
            total_bits=$(extract_field "total_bits" "$log_file")
            digest_checksum=$(extract_field "digest_checksum" "$log_file")
            perf=$(extract_perf "$log_file")
            IFS=$'\t' read -r instrs cycles ipc <<< "$perf"
            row_key="$DISPATCH|$dataset|$DRIVER|$MESSAGES|${actual_cases:-$CASES}|$total_messages"
            if [[ "$mode" == "SOFTWARE" && -n "$cycles" ]]; then
                software_cycles["$row_key"]="$cycles"
            fi

            # Store the display-ready fields plus the raw comparison key. The
            # key is not written to the TSV; it is only used below to find the
            # matching SOFTWARE baseline for cycles_speedup.
            rows+=("keccak"$'\t'"$mode"$'\t'"$DISPATCH"$'\t'"$dataset"$'\t'"$DRIVER"$'\t'"$(format_number "$MESSAGES")"$'\t'"$(format_number "${actual_cases:-$CASES}")"$'\t'"$(format_number "$total_messages")"$'\t'"$(format_number "$total_bits")"$'\t'"$digest_checksum"$'\t'"$instrs"$'\t'"$cycles"$'\t'"$ipc"$'\t'"$status"$'\t'"$log_file"$'\t'"$row_key")
        done
    done

    # Emit the final TSV only after all runs have completed. This makes speedup
    # stable regardless of ACCEL_MODES order and keeps partial rows out of the
    # result file until each row has all derived fields.
    printf 'algo\taccel_mode\tdispatch_mode\tdataset\tdriver\tmessages_per_task\tdataset_cases\ttotal_messages\ttotal_bits\tdigest_checksum\tinstrs\tcycles\tcycles_speedup\tipc\tstatus\tlog\n' > "$RESULTS"
    local row
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r algo mode dispatch dataset driver messages actual_cases total_messages total_bits digest_checksum instrs cycles ipc status log_file row_key <<< "$row"
        local speedup=""

        # cycles_speedup is defined as SOFTWARE cycles divided by this row's
        # cycles for the same dispatch/dataset/backend. SOFTWARE is the
        # baseline and reports 1x. If no matching SOFTWARE row was requested,
        # leave the field empty rather than inventing a comparison.
        if [[ "$mode" == "SOFTWARE" && -n "$cycles" ]]; then
            speedup="1x"
        elif [[ -n "$row_key" && -n "${software_cycles[$row_key]:-}" && -n "$cycles" ]]; then
            speedup=$(format_speedup "${software_cycles[$row_key]}" "$cycles")
        fi

        # Write one tab-separated row. Logs are per dataset/mode/backend, which
        # keeps checksum mismatches and performance regressions easy to trace.
        printf 'keccak\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$mode" "$dispatch" "$dataset" "$driver" \
            "$messages" "$actual_cases" "$total_messages" "$total_bits" "$digest_checksum" \
            "$instrs" "$cycles" "$speedup" "$ipc" "$status" "$log_file" >> "$RESULTS"
    done

    [[ "$failures" -eq 0 ]]
}

main "$@"
