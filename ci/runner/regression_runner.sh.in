set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
if [[ -f "$SCRIPT_DIR/runner_common.sh" ]]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh"
else
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh.in"
fi

show_usage() {
    cat <<EOF
Vortex Regression Runner

Usage:
  $0 [options]

Options:
  --driver=<simx|rtlsim|de10pro>    Backend driver (default: simx)
  --apps=<list|all>                 Comma-separated app list (default: all)
  --opts=<args>                     Override runtime args for every app
  --output-root=<path>               Output root (default: <build>/runner_output)
  --results=<path>                  TSV output path (default: <output-root>/regression/results/<driver>/results.tsv)
  --log-dir=<path>                  Run log directory (default: <output-root>/regression/logs/<driver>)
  --startup-addr=<hex>              Kernel startup address (default: 0x80000000)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

Supported apps:
  basic, basic_diag, demo, dogfood, dropout, dotproduct, mstress,
  io_addr, printf, diverge, sort, fence, vecadd, sgemm, conv3,
  relu, sgemv, sgemm2, madmax, stencil3d

Notes:
  Crypto apps are intentionally excluded from this generic runner. Use the
  AES/SHA/Keccak runner scripts under ci/runner for crypto smoke and benchmark
  tests with structured TSV output.

Examples:
  $0 --driver=simx --apps=all --fd-disable
  $0 --driver=de10pro --apps=basic,demo --fd-disable
  $0 --driver=rtlsim --apps=basic_diag,vecadd --fd-disable --debug=3
EOF
}

default_app_opts() {
    case "$1" in
        basic)
            echo "-t1 -n128"
            ;;
        demo)
            echo "-n1"
            ;;
        basic_diag|dogfood|dropout|dotproduct|mstress|io_addr|printf|diverge|sort|fence|vecadd|sgemm|conv3|relu|sgemv|sgemm2|madmax|stencil3d)
            echo ""
            ;;
        *)
            die "unsupported app: $1"
            ;;
    esac
}

validate_apps() {
    local app
    for app in "${APPS[@]}"; do
        case "$app" in
            basic|basic_diag|demo|dogfood|dropout|dotproduct|mstress|io_addr|printf|diverge|sort|fence|vecadd|sgemm|conv3|relu|sgemv|sgemm2|madmax|stencil3d)
                ;;
            *)
                die "unsupported app: $app"
                ;;
        esac
    done
}

build_driver_runtime() {
    build_driver_runtime_common "$DRIVER" 5000
}

main() {
    RUNNER_NAME="regression"
    DRIVER="simx"
    STARTUP_ADDR="0x80000000"
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    OPTS_OVERRIDE=""
    OUTPUT_ROOT="$ROOT_DIR/runner_output"
    RESULTS=""
    LOG_DIR=""

    local app_list="all"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver=*)
                DRIVER="${1#*=}"
                ;;
            --apps=*)
                app_list="${1#*=}"
                ;;
            --opts=*)
                OPTS_OVERRIDE="${1#*=}"
                ;;
            --output-root=*)
                OUTPUT_ROOT="${1#*=}"
                ;;
            --results=*)
                RESULTS="${1#*=}"
                ;;
            --log-dir=*)
                LOG_DIR="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    if [[ "$app_list" == "all" ]]; then
        APPS=(basic basic_diag demo dogfood dropout dotproduct mstress io_addr printf diverge sort fence vecadd sgemm conv3 relu sgemv sgemm2 madmax stencil3d)
    else
        IFS=',' read -r -a APPS <<< "$app_list"
    fi
    validate_apps

    load_xlen
    source_toolchain_env
    init_single_driver_output

    echo "ROOT_DIR=$ROOT_DIR"
    echo "OUTPUT_ROOT=$OUTPUT_ROOT"
    echo "XLEN=$XLEN"
    echo "DRIVER=$DRIVER"
    echo "APPS=${APPS[*]}"
    echo "STARTUP_ADDR=$STARTUP_ADDR"
    echo "EXT_F_DISABLE=$EXT_F_DISABLE"
    echo "EXT_D_DISABLE=$EXT_D_DISABLE"
    echo "RESULTS=$RESULTS"

    run_cmd make -C "$ROOT_DIR/hw" config
    build_kernel
    build_driver_runtime

    printf 'app\tdriver\tstatus\tlog\n' > "$RESULTS"

    local failures=0
    local app
    for app in "${APPS[@]}"; do
        local app_dir="$ROOT_DIR/tests/regression/$app"
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        local app_opts
        if [[ -n "$OPTS_OVERRIDE" ]]; then
            app_opts="$OPTS_OVERRIDE"
        else
            app_opts=$(default_app_opts "$app")
        fi

        local run_args=("make" "-C" "$app_dir" "run-$DRIVER")
        if [[ -n "$app_opts" ]]; then
            run_args+=("OPTS=$app_opts")
        fi

        local log_file="$LOG_DIR/${app}-${DRIVER}.log"
        echo
        echo "== Running $app on $DRIVER =="
        if "${run_args[@]}" 2>&1 | tee "$log_file"; then
            printf '%s\t%s\tok\t%s\n' "$app" "$DRIVER" "$log_file" >> "$RESULTS"
        else
            failures=$((failures + 1))
            printf '%s\t%s\tfail\t%s\n' "$app" "$DRIVER" "$log_file" >> "$RESULTS"
            echo "FAILED: $app on $DRIVER" >&2
        fi
        echo
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures app(s) failed; partial results are in $RESULTS"
    fi

    echo "All requested apps passed on $DRIVER; results written to $RESULTS"
}

main "$@"
