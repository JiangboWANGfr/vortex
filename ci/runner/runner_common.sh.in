#!/bin/bash

# Shared helpers for ci/runner/*.sh.in scripts.  This file is sourced by the
# runner templates in-tree and by the generated scripts under the build tree.

RUNNER_COMMON_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ROOT_DIR=${ROOT_DIR:-$(realpath "$RUNNER_COMMON_DIR/../..")}

die() {
    echo "Error: $*" >&2
    exit 1
}

run_cmd() {
    echo "+ $*"
    "$@"
}

format_number() {
    local value="$1"
    if [[ -z "$value" ]]; then
        printf ''
        return
    fi
    printf '%s' "$value" | perl -pe 's/(?<=\d)(?=(?:\d{3})+(?!\d))/,/g'
}

normalize_number() {
    local value="$1"
    printf '%s' "$value" | tr -d ','
}

format_speedup() {
    local baseline="$1"
    local cycles="$2"
    if [[ -z "$baseline" || -z "$cycles" || "$baseline" == "0" || "$cycles" == "0" ]]; then
        printf ''
        return
    fi
    perl -e '$r = $ARGV[0] / $ARGV[1]; $s = sprintf("%.2fx", $r); $s =~ s/\.00x$/x/; $s =~ s/(\.\d)0x$/$1x/; print $s;' "$baseline" "$cycles"
}

join_flags() {
    local result=()
    if [[ "${EXT_F_DISABLE:-0}" -eq 1 ]]; then
        result+=("EXT_F_DISABLE=1")
    fi
    if [[ "${EXT_D_DISABLE:-0}" -eq 1 ]]; then
        result+=("EXT_D_DISABLE=1")
    fi
    printf '%s\n' "${result[@]}"
}

validate_driver() {
    case "$1" in
        simx|rtlsim|de10pro)
            ;;
        *)
            die "unsupported driver: $1; supported: simx rtlsim de10pro"
            ;;
    esac
}

load_xlen() {
    if [[ ! -f "$ROOT_DIR/config.mk" ]]; then
        die "config.mk not found under $ROOT_DIR"
    fi

    XLEN=$(sed -n 's/^XLEN[[:space:]]*?=[[:space:]]*//p' "$ROOT_DIR/config.mk" | head -n1 | tr -d '[:space:]')
    if [[ -z "$XLEN" ]]; then
        die "failed to determine XLEN from $ROOT_DIR/config.mk"
    fi
}

set_default_startup_addr() {
    if [[ -z "${STARTUP_ADDR:-}" ]]; then
        if [[ "$XLEN" == "64" ]]; then
            STARTUP_ADDR="0x180000000"
        else
            STARTUP_ADDR="0x80000000"
        fi
    fi
}

source_toolchain_env() {
    if [[ -f "$ROOT_DIR/ci/toolchain_env.sh" ]]; then
        # shellcheck disable=SC1091
        source "$ROOT_DIR/ci/toolchain_env.sh"
    fi
}

init_single_driver_output() {
    local run_output_dir="$OUTPUT_ROOT/$RUNNER_NAME"
    LOG_DIR="${LOG_DIR:-$run_output_dir/logs/$DRIVER}"
    RESULTS="${RESULTS:-$run_output_dir/results/$DRIVER/results.tsv}"
    mkdir -p "$LOG_DIR" "$(dirname "$RESULTS")"
}

init_multi_driver_output() {
    local run_output_dir="$OUTPUT_ROOT/$RUNNER_NAME"
    LOG_DIR="${LOG_DIR:-$run_output_dir/logs}"
    RESULTS="${RESULTS:-$run_output_dir/results/all/results.tsv}"
    mkdir -p "$LOG_DIR" "$(dirname "$RESULTS")"
}

# Build the shared Vortex kernel runtime objects once for this runner
# invocation.  EXT_F_DISABLE / EXT_D_DISABLE are folded in so every test binary
# links against a kernel runtime that matches the requested ISA configuration.
build_kernel() {
    local kernel_args=("make" "-C" "$ROOT_DIR/kernel" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && kernel_args+=("$flag")
    done < <(join_flags)
    run_cmd "${kernel_args[@]}"
}

setup_de10pro_env() {
    local default_timeout="${1:-5000}"
    export TERASIC_PCIE_SO_PATH="${TERASIC_PCIE_SO_PATH:-$ROOT_DIR/../PCIe_SW_KIT/PCIe_DDR4/32G/terasic_pcie_qsys.so}"
    export DE10PRO_VX_TIMEOUT_MS="${DE10PRO_VX_TIMEOUT_MS:-$default_timeout}"
    export DE10PRO_VX_VERBOSE_STATUS="${DE10PRO_VX_VERBOSE_STATUS:-1}"
    export DE10PRO_VX_BAR="${DE10PRO_VX_BAR:-4}"
    export DE10PRO_VX_MMIO_BASE="${DE10PRO_VX_MMIO_BASE:-0x4001000}"
    export DE10PRO_VX_STAGING_ADDR="${DE10PRO_VX_STAGING_ADDR:-0x800000000}"
    export DE10PRO_VX_STAGING_SIZE="${DE10PRO_VX_STAGING_SIZE:-0x200000}"
}

# The runners own driver construction: they rebuild it per accel-mode and per
# design-space knob, with CONFIGS the test Makefiles never see. Tell the test
# harness not to rebuild it back to the test's own CONFIGS.
export VX_SKIP_DRIVER_BUILD=1

build_driver_runtime_common() {
    local driver="$1"
    local de10pro_timeout="${2:-5000}"
    shift 2 || true
    local extra_args=("$@")

    validate_driver "$driver"
    run_cmd make -C "$ROOT_DIR/runtime/stub" clean all

    local args=("make" "-C" "$ROOT_DIR/runtime/$driver" "clean" "all")
    if [[ "${#extra_args[@]}" -ne 0 ]]; then
        args+=("${extra_args[@]}")
    fi

    case "$driver" in
        simx|rtlsim)
            run_cmd env -u DEBUG CCACHE_DISABLE=1 "${args[@]}" "DEBUG=$DEBUG_LEVEL"
            ;;
        de10pro)
            run_cmd "${args[@]}"
            setup_de10pro_env "$de10pro_timeout"
            ;;
    esac
}
