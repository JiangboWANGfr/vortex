#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
if [[ -f "$SCRIPT_DIR/runner_common.sh" ]]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh"
else
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh.in"
fi

show_usage() {
    cat <<EOF
Vortex SHA-256 Benchmark Runner

Usage:
  $0 [options]

Options:
  --driver=<simx|rtlsim|de10pro>    Backend driver (default: simx)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE)
  --messages=<n>                    Messages per hardware task (default: 1)
  --msg-bytes=<n>                   Payload bytes per message (default: 128)
  --output-root=<path>               Output root (default: <build>/runner_output)
  --results=<path>                  TSV output path (default: <output-root>/sha256_bench/results/<driver>/results.tsv)
  --log-dir=<path>                  Run log directory (default: <output-root>/sha256_bench/logs/<driver>)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

Supported SHA_ACCEL_MODE values:
  NATIVE, SOFTWARE

Examples:
  $0 --driver=simx --accel-modes=NATIVE,SOFTWARE --messages=4 --msg-bytes=1024 --fd-disable --results=sha256-bench-simx.tsv --log-dir=sha256-bench-simx-logs
  $0 --driver=rtlsim --accel-modes=NATIVE --messages=1 --msg-bytes=128 --fd-disable

EOF
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE)
            ;;
        *)
            die "unsupported SHA_ACCEL_MODE=$1; supported: NATIVE SOFTWARE"
            ;;
    esac
}

build_driver_runtime() {
    build_driver_runtime_common "$DRIVER" 5000
}

extract_field() {
    local pattern="$1"
    local file="$2"
    grep -a "^SHA256_BENCH: .*${pattern}=" "$file" | tail -n 1 | sed -nE "s/.*${pattern}=([0-9,]+).*/\\1/p" | tr -d ',' || true
}

extract_perf() {
    local file="$1"
    local line
    line=$(grep -a 'PERF: instrs=' "$file" | tail -n 1 || true)
    if [[ -z "$line" ]]; then
        printf '\t\t'
        return
    fi
    printf '%s' "$line" | sed -E 's/.*instrs=([0-9,]+), cycles=([0-9,]+), IPC=([0-9.]+).*/\1\t\2\t\3/' | tr -d ','
}

main() {
    RUNNER_NAME="sha256_bench"
    DRIVER="simx"
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    MESSAGES="1"
    MSG_BYTES="128"
    OUTPUT_ROOT="$ROOT_DIR/runner_output"
    RESULTS=""
    LOG_DIR=""
    accel_mode_list="NATIVE"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver=*)
                DRIVER="${1#*=}"
                ;;
            --accel-modes=*)
                accel_mode_list="${1#*=}"
                ;;
            --messages=*)
                MESSAGES="${1#*=}"
                ;;
            --msg-bytes=*)
                MSG_BYTES="${1#*=}"
                ;;
            --output-root=*)
                OUTPUT_ROOT="${1#*=}"
                ;;
            --results=*)
                RESULTS="${1#*=}"
                ;;
            --log-dir=*)
                LOG_DIR="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    # Parse and validate command-line options before doing any expensive builds.
    if [[ ! "$MESSAGES" =~ ^[0-9]+$ ]] || [[ "$MESSAGES" -eq 0 ]]; then
        die "--messages must be a positive integer"
    fi
    if [[ ! "$MSG_BYTES" =~ ^[0-9]+$ ]] || [[ "$MSG_BYTES" -eq 0 ]]; then
        die "--msg-bytes must be a positive integer"
    fi

    IFS=',' read -r -a ACCEL_MODES <<< "$accel_mode_list"

    local mode
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
    done

    # Resolve build configuration, toolchain paths, and runner output folders.
    load_xlen
    set_default_startup_addr
    source_toolchain_env
    init_single_driver_output

    echo "ROOT_DIR=$ROOT_DIR"
    echo "OUTPUT_ROOT=$OUTPUT_ROOT"
    echo "XLEN=$XLEN"
    echo "DRIVER=$DRIVER"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "MESSAGES=$MESSAGES"
    echo "MSG_BYTES=$MSG_BYTES"
    echo "RESULTS=$RESULTS"

    # Generate hardware config headers, build the common kernel runtime, then
    # build the selected host/device runtime backend.
    run_cmd make -C "$ROOT_DIR/hw" config
    build_kernel
    build_driver_runtime

    # Run each accel mode, collect logs, and defer TSV emission until SOFTWARE
    # baselines are known for cycles_speedup calculation.
    local app_dir="$ROOT_DIR/tests/regression/sha256_bench"
    local failures=0

    # rows holds formatted result records in memory. We cannot write rows
    # immediately because NATIVE rows need the matching SOFTWARE cycle count
    # to compute cycles_speedup, and SOFTWARE may appear later in ACCEL_MODES.
    local -a rows=()

    # software_cycles maps one comparable workload to its SOFTWARE cycle count.
    # Key fields are driver, messages_per_task, msg_bytes, total_messages, and
    # total_bytes; this avoids comparing runs with different input sizes.
    declare -A software_cycles=()

    # Build once per acceleration mode because SHA_ACCEL_MODE changes compile
    # flags and selects either native SHA instructions or the software path.
    for mode in "${ACCEL_MODES[@]}"; do
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "SHA_ACCEL_MODE=$mode")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        # Each mode gets one run and one log. Keep the log path in the TSV so
        # failures and malformed PERF lines can be inspected directly.
        local safe_mode
        local log_file
        local status
        local total_messages
        local total_bytes
        local perf
        local perf_instrs
        local perf_cycles
        local perf_ipc
        safe_mode=${mode//,/+}
        log_file="$LOG_DIR/sha256-${safe_mode}.log"

        echo
        echo "== Running sha256_bench mode=$mode on $DRIVER =="
        if make -C "$app_dir" "run-$DRIVER" "SHA_ACCEL_MODE=$mode" "OPTS=-n $MESSAGES -m $MSG_BYTES" 2>&1 | tee "$log_file"; then
            status="ok"
        else
            status="fail"
            failures=$((failures + 1))
        fi

        # Pull benchmark size and performance summary out of the run log.
        # extract_* uses grep -a because device-side cout can include NUL
        # bytes, which otherwise makes grep treat logs as binary files.
        total_messages=$(extract_field "total_messages" "$log_file")
        total_bytes=$(extract_field "total_bytes" "$log_file")
        perf=$(extract_perf "$log_file")
        IFS=$'\t' read -r perf_instrs perf_cycles perf_ipc <<< "$perf"

        # Store the SOFTWARE baseline before formatting cycles with commas.
        # format_speedup expects raw numeric strings for arithmetic.
        local row_key
        row_key="$DRIVER|$(normalize_number "$MESSAGES")|$(normalize_number "$MSG_BYTES")|$total_messages|$total_bytes"
        if [[ "$mode" == "SOFTWARE" && -n "$perf_cycles" ]]; then
            software_cycles["$row_key"]="$perf_cycles"
        fi

        # Store the display-ready fields plus the raw comparison key. The key
        # is only used below to find the matching SOFTWARE baseline.
        rows+=("sha256"$'\t'"$mode"$'\t'"$DRIVER"$'\t'"$(format_number "$(normalize_number "$MESSAGES")")"$'\t'"$(format_number "$(normalize_number "$MSG_BYTES")")"$'\t'"$(format_number "$total_messages")"$'\t'"$(format_number "$total_bytes")"$'\t'"$(format_number "$perf_instrs")"$'\t'"$(format_number "$perf_cycles")"$'\t'"${perf_ipc:-}"$'\t'"$status"$'\t'"$log_file"$'\t'"$row_key")
    done

    # Emit the final TSV only after all runs have completed. This makes speedup
    # stable regardless of ACCEL_MODES order and keeps partial rows out of the
    # result file until each row has all derived fields.
    printf 'algo\taccel_mode\tdriver\tmessages_per_task\tmsg_bytes\ttotal_messages\ttotal_bytes\tinstrs\tcycles\tcycles_speedup\tIPC\tstatus\tlog\n' > "$RESULTS"
    local row
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r algo mode driver messages msg_bytes total_messages total_bytes perf_instrs perf_cycles perf_ipc status log_file row_key <<< "$row"
        local speedup=""

        # cycles_speedup is defined as SOFTWARE cycles divided by this row's
        # cycles for the same message size/backend. SOFTWARE is the baseline
        # and reports 1x. If no matching SOFTWARE row was requested, leave the
        # field empty rather than inventing a comparison.
        if [[ "$mode" == "SOFTWARE" && -n "$perf_cycles" ]]; then
            speedup="1x"
        elif [[ -n "${software_cycles[$row_key]:-}" && -n "$perf_cycles" ]]; then
            speedup=$(format_speedup "${software_cycles[$row_key]}" "$(normalize_number "$perf_cycles")")
        fi

        # Write one tab-separated row. All numeric display fields are already
        # formatted; log remains an absolute or caller-provided path for direct
        # debugging.
        printf 'sha256\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$mode" "$driver" "$messages" "$msg_bytes" "$total_messages" "$total_bytes" \
            "$perf_instrs" "$perf_cycles" "$speedup" "$perf_ipc" "$status" "$log_file" >> "$RESULTS"
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures SHA-256 benchmark run(s) failed; partial results are in $RESULTS"
    fi

    echo "SHA-256 benchmark results written to $RESULTS"
}

main "$@"
