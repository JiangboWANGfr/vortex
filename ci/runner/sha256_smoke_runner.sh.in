#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
if [[ -f "$SCRIPT_DIR/runner_common.sh" ]]; then
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh"
else
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/runner_common.sh.in"
fi

show_usage() {
    cat <<EOF
Vortex SHA-256 Smoke Runner

Usage:
  $0 [options]

Options:
  --drivers=<list>                  Comma-separated backends (default: simx,rtlsim)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE,SOFTWARE)
  --output-root=<path>               Output root (default: <build>/runner_output)
  --results=<path>                  Aggregate TSV output path (default: <output-root>/sha256_smoke/results/all/results.tsv)
  --log-dir=<path>                  Run log root (default: <output-root>/sha256_smoke/logs)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --include-rtlsim-native           Compatibility no-op; rtlsim+NATIVE now runs by default
  --help                            Show this help

Supported SHA_ACCEL_MODE values:
  NATIVE, SOFTWARE

Development default:
  simx and rtlsim run the requested NATIVE and SOFTWARE modes.

Example:
  $0 --drivers=simx,rtlsim --accel-modes=NATIVE,SOFTWARE --fd-disable
  $0 --drivers=simx,rtlsim --include-rtlsim-native --debug=1

EOF
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE)
            ;;
        *)
            die "unsupported SHA_ACCEL_MODE=$1; supported: NATIVE SOFTWARE"
            ;;
    esac
}

build_driver_runtime() {
    local driver="$1"
    build_driver_runtime_common "$driver" 5000
}

main() {
    RUNNER_NAME="sha256_smoke"
    DRIVER_LIST="simx,rtlsim"
    ACCEL_MODE_LIST="NATIVE,SOFTWARE"
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    OUTPUT_ROOT="$ROOT_DIR/runner_output"
    RESULTS=""
    LOG_DIR=""
    INCLUDE_RTLSIM_NATIVE=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --drivers=*)
                DRIVER_LIST="${1#*=}"
                ;;
            --accel-modes=*)
                ACCEL_MODE_LIST="${1#*=}"
                ;;
            --output-root=*)
                OUTPUT_ROOT="${1#*=}"
                ;;
            --results=*)
                RESULTS="${1#*=}"
                ;;
            --log-dir=*)
                LOG_DIR="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --include-rtlsim-native)
                INCLUDE_RTLSIM_NATIVE=1
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    # Parse and validate command-line options before doing any expensive builds.
    IFS=',' read -r -a DRIVERS <<< "$DRIVER_LIST"
    IFS=',' read -r -a ACCEL_MODES <<< "$ACCEL_MODE_LIST"

    local driver
    for driver in "${DRIVERS[@]}"; do
        validate_driver "$driver"
    done

    local mode
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
    done

    # Resolve build configuration, toolchain paths, and runner output folders.
    load_xlen
    set_default_startup_addr
    source_toolchain_env
    init_multi_driver_output
    local run_output_dir="$OUTPUT_ROOT/$RUNNER_NAME"

    echo "ROOT_DIR=$ROOT_DIR"
    echo "OUTPUT_ROOT=$OUTPUT_ROOT"
    echo "XLEN=$XLEN"
    echo "DRIVERS=${DRIVERS[*]}"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "RESULTS=$RESULTS"

    # Generate hardware config headers, build the common kernel runtime, then
    # build every requested host/device runtime backend.
    run_cmd make -C "$ROOT_DIR/hw" config
    build_kernel
    for driver in "${DRIVERS[@]}"; do
        build_driver_runtime "$driver"
    done

    # Prepare aggregate and per-driver TSVs before running the smoke matrix.
    printf 'algo\taccel_mode\tdriver\tstatus\tlog\n' > "$RESULTS"
    for driver in "${DRIVERS[@]}"; do
        # Per-driver result files make it easy to archive or compare one backend
        # without filtering the aggregate TSV by hand.
        mkdir -p "$LOG_DIR/$driver" "$run_output_dir/results/$driver"
        printf 'algo\taccel_mode\tdriver\tstatus\tlog\n' > "$run_output_dir/results/$driver/results.tsv"
    done

    # Run each accel-mode/driver pair and append both aggregate and per-driver
    # rows so single-driver and whole-matrix views stay in sync.
    local app_dir="$ROOT_DIR/tests/kernel/sha256"
    local failures=0
    for mode in "${ACCEL_MODES[@]}"; do
        # SHA_ACCEL_MODE changes compile-time selection between native SHA
        # instructions and the software implementation, so rebuild per mode.
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "SHA_ACCEL_MODE=$mode")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        # Run the same mode-specific binary on each requested backend. Logs are
        # grouped by driver to mirror the result directory layout.
        for driver in "${DRIVERS[@]}"; do
            local log_file="$LOG_DIR/$driver/sha256-${mode}-${driver}.log"
            local status
            echo
            echo "== Running sha256 mode=$mode on $driver =="
            if make -C "$app_dir" "run-$driver" "SHA_ACCEL_MODE=$mode" 2>&1 | tee "$log_file"; then
                status="ok"
            else
                status="fail"
                failures=$((failures + 1))
            fi

            # Append to both TSV views: the aggregate file for the full matrix
            # and the per-driver file for backend-specific summaries.
            printf 'sha256\t%s\t%s\t%s\t%s\n' "$mode" "$driver" "$status" "$log_file" >> "$RESULTS"
            printf 'sha256\t%s\t%s\t%s\t%s\n' "$mode" "$driver" "$status" "$log_file" >> "$run_output_dir/results/$driver/results.tsv"
        done
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures SHA-256 smoke run(s) failed; partial results are in $RESULTS"
    fi

    echo "SHA-256 smoke results written to $RESULTS"
}

main "$@"
