#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ROOT_DIR=$(realpath "$SCRIPT_DIR/..")

show_usage() {
    cat <<EOF
Vortex SHA-256 Benchmark Runner

Usage:
  $0 [options]

Options:
  --driver=<simx|rtlsim|de10pro>    Backend driver (default: simx)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE)
  --messages=<n>                    Messages per hardware task (default: 1)
  --msg-bytes=<n>                   Payload bytes per message (default: 128)
  --results=<path>                  TSV output path (default: sha256-bench-results.tsv)
  --log-dir=<path>                  Run log directory (default: sha256-bench-logs)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --help                            Show this help

Supported SHA_ACCEL_MODE values:
  NATIVE, SOFTWARE

Examples:
  $0 --driver=simx --accel-modes=NATIVE,SOFTWARE --messages=4 --msg-bytes=1024 --fd-disable --results=sha256-bench-simx.tsv --log-dir=sha256-bench-simx-logs
  $0 --driver=rtlsim --accel-modes=NATIVE --messages=1 --msg-bytes=128 --fd-disable

EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

run_cmd() {
    echo "+ $*"
    "$@"
}

format_number() {
    local value="$1"
    if [[ -z "$value" ]]; then
        printf ''
        return
    fi
    printf '%s' "$value" | perl -pe 's/(?<=\d)(?=(?:\d{3})+(?!\d))/,/g'
}

normalize_number() {
    local value="$1"
    printf '%s' "$value" | tr -d ','
}

join_flags() {
    local result=()
    if [[ "$EXT_F_DISABLE" -eq 1 ]]; then
        result+=("EXT_F_DISABLE=1")
    fi
    if [[ "$EXT_D_DISABLE" -eq 1 ]]; then
        result+=("EXT_D_DISABLE=1")
    fi
    printf '%s\n' "${result[@]}"
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE)
            ;;
        *)
            die "unsupported SHA_ACCEL_MODE=$1; supported: NATIVE SOFTWARE"
            ;;
    esac
}

build_driver_runtime() {
    case "$DRIVER" in
        simx)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd env CCACHE_DISABLE=1 make -C "$ROOT_DIR/runtime/simx" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        rtlsim)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd env CCACHE_DISABLE=1 make -C "$ROOT_DIR/runtime/rtlsim" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        de10pro)
            run_cmd make -C "$ROOT_DIR/runtime/stub" clean all
            run_cmd make -C "$ROOT_DIR/runtime/de10pro" clean all
            export TERASIC_PCIE_SO_PATH="${TERASIC_PCIE_SO_PATH:-$ROOT_DIR/../PCIe_SW_KIT/PCIe_DDR4/32G/terasic_pcie_qsys.so}"
            export DE10PRO_VX_TIMEOUT_MS="${DE10PRO_VX_TIMEOUT_MS:-5000}"
            export DE10PRO_VX_VERBOSE_STATUS="${DE10PRO_VX_VERBOSE_STATUS:-1}"
            export DE10PRO_VX_BAR="${DE10PRO_VX_BAR:-4}"
            export DE10PRO_VX_MMIO_BASE="${DE10PRO_VX_MMIO_BASE:-0x4001000}"
            export DE10PRO_VX_STAGING_ADDR="${DE10PRO_VX_STAGING_ADDR:-0x800000000}"
            export DE10PRO_VX_STAGING_SIZE="${DE10PRO_VX_STAGING_SIZE:-0x200000}"
            ;;
        *)
            die "unsupported driver: $DRIVER"
            ;;
    esac
}

extract_field() {
    local pattern="$1"
    local file="$2"
    grep "^SHA256_BENCH: .*${pattern}=" "$file" | tail -n 1 | sed -nE "s/.*${pattern}=([0-9,]+).*/\\1/p" | tr -d ',' || true
}

extract_perf() {
    local file="$1"
    local line
    line=$(grep 'PERF: instrs=' "$file" | tail -n 1 || true)
    if [[ -z "$line" ]]; then
        printf '\t\t'
        return
    fi
    printf '%s' "$line" | sed -E 's/.*instrs=([0-9,]+), cycles=([0-9,]+), IPC=([0-9.]+).*/\1\t\2\t\3/' | tr -d ','
}

main() {
    DRIVER="simx"
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    MESSAGES="1"
    MSG_BYTES="128"
    RESULTS="sha256-bench-results.tsv"
    LOG_DIR="sha256-bench-logs"
    accel_mode_list="NATIVE"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver=*)
                DRIVER="${1#*=}"
                ;;
            --accel-modes=*)
                accel_mode_list="${1#*=}"
                ;;
            --messages=*)
                MESSAGES="${1#*=}"
                ;;
            --msg-bytes=*)
                MSG_BYTES="${1#*=}"
                ;;
            --results=*)
                RESULTS="${1#*=}"
                ;;
            --log-dir=*)
                LOG_DIR="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    if [[ ! "$MESSAGES" =~ ^[0-9]+$ ]] || [[ "$MESSAGES" -eq 0 ]]; then
        die "--messages must be a positive integer"
    fi
    if [[ ! "$MSG_BYTES" =~ ^[0-9]+$ ]] || [[ "$MSG_BYTES" -eq 0 ]]; then
        die "--msg-bytes must be a positive integer"
    fi

    IFS=',' read -r -a ACCEL_MODES <<< "$accel_mode_list"

    local mode
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
    done

    if [[ ! -f "$ROOT_DIR/config.mk" ]]; then
        die "config.mk not found under $ROOT_DIR"
    fi

    XLEN=$(sed -n 's/^XLEN[[:space:]]*?=[[:space:]]*//p' "$ROOT_DIR/config.mk" | head -n1 | tr -d '[:space:]')
    if [[ -z "$XLEN" ]]; then
        die "failed to determine XLEN from $ROOT_DIR/config.mk"
    fi
    if [[ -z "$STARTUP_ADDR" ]]; then
        if [[ "$XLEN" == "64" ]]; then
            STARTUP_ADDR="0x180000000"
        else
            STARTUP_ADDR="0x80000000"
        fi
    fi

    if [[ -f "$ROOT_DIR/ci/toolchain_env.sh" ]]; then
        # shellcheck disable=SC1091
        source "$ROOT_DIR/ci/toolchain_env.sh"
    fi

    mkdir -p "$LOG_DIR"

    echo "ROOT_DIR=$ROOT_DIR"
    echo "XLEN=$XLEN"
    echo "DRIVER=$DRIVER"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "MESSAGES=$MESSAGES"
    echo "MSG_BYTES=$MSG_BYTES"
    echo "RESULTS=$RESULTS"

    run_cmd make -C "$ROOT_DIR/hw" config

    local kernel_args=("make" "-C" "$ROOT_DIR/kernel" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && kernel_args+=("$flag")
    done < <(join_flags)
    run_cmd "${kernel_args[@]}"

    build_driver_runtime

    printf 'algo\taccel_mode\tdriver\tmessages_per_task\tmsg_bytes\ttotal_messages\ttotal_bytes\tinstrs\tcycles\tIPC\tstatus\tlog\n' > "$RESULTS"

    local app_dir="$ROOT_DIR/tests/regression/sha256_bench"
    local failures=0
    for mode in "${ACCEL_MODES[@]}"; do
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "SHA_ACCEL_MODE=$mode")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        local safe_mode
        local log_file
        local status
        local total_messages
        local total_bytes
        local perf
        local perf_instrs
        local perf_cycles
        local perf_ipc
        safe_mode=${mode//,/+}
        log_file="$LOG_DIR/sha256-${safe_mode}.log"

        echo
        echo "== Running sha256_bench mode=$mode on $DRIVER =="
        if make -C "$app_dir" "run-$DRIVER" "SHA_ACCEL_MODE=$mode" "OPTS=-n $MESSAGES -m $MSG_BYTES" 2>&1 | tee "$log_file"; then
            status="ok"
        else
            status="fail"
            failures=$((failures + 1))
        fi

        total_messages=$(extract_field "total_messages" "$log_file")
        total_bytes=$(extract_field "total_bytes" "$log_file")
        perf=$(extract_perf "$log_file")
        IFS=$'\t' read -r perf_instrs perf_cycles perf_ipc <<< "$perf"
        printf 'sha256\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$mode" "$DRIVER" "$(format_number "$(normalize_number "$MESSAGES")")" \
            "$(format_number "$(normalize_number "$MSG_BYTES")")" \
            "$(format_number "$total_messages")" "$(format_number "$total_bytes")" \
            "$(format_number "$perf_instrs")" "$(format_number "$perf_cycles")" "${perf_ipc:-}" \
            "$status" "$log_file" >> "$RESULTS"
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures SHA-256 benchmark run(s) failed; partial results are in $RESULTS"
    fi

    echo "SHA-256 benchmark results written to $RESULTS"
}

main "$@"
