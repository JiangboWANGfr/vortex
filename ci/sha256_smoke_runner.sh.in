#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
ROOT_DIR=$(realpath "$SCRIPT_DIR/..")

show_usage() {
    cat <<EOF
Vortex SHA-256 Smoke Runner

Usage:
  $0 [options]

Options:
  --drivers=<list>                  Comma-separated backends (default: simx,rtlsim)
  --accel-modes=<list>              Comma-separated modes (default: NATIVE,SOFTWARE)
  --results=<path>                  TSV output path (default: sha256-smoke-results.tsv)
  --log-dir=<path>                  Run log directory (default: sha256-smoke-logs)
  --startup-addr=<hex>              Kernel startup address (default: XLEN-specific)
  --ext-f-disable                   Build with EXT_F_DISABLE=1
  --ext-d-disable                   Build with EXT_D_DISABLE=1
  --fd-disable                      Shorthand for both ext-f-disable and ext-d-disable
  --debug=<level>                   Debug level passed to simulators (default: 0)
  --include-rtlsim-native           Also run rtlsim+NATIVE once RTL SHA support exists
  --help                            Show this help

Supported SHA_ACCEL_MODE values:
  NATIVE, SOFTWARE

Development default:
  simx runs NATIVE and SOFTWARE. rtlsim runs SOFTWARE only because SHA RTL is
  intentionally not wired up yet.

Example:
  $0 --drivers=simx,rtlsim --accel-modes=NATIVE,SOFTWARE --fd-disable
  $0 --drivers=simx,rtlsim --include-rtlsim-native --debug=1

EOF
}

die() {
    echo "Error: $*" >&2
    exit 1
}

run_cmd() {
    echo "+ $*"
    "$@"
}

join_flags() {
    local result=()
    if [[ "$EXT_F_DISABLE" -eq 1 ]]; then
        result+=("EXT_F_DISABLE=1")
    fi
    if [[ "$EXT_D_DISABLE" -eq 1 ]]; then
        result+=("EXT_D_DISABLE=1")
    fi
    printf '%s\n' "${result[@]}"
}

validate_driver() {
    case "$1" in
        simx|rtlsim)
            ;;
        *)
            die "unsupported driver: $1; supported: simx rtlsim"
            ;;
    esac
}

validate_accel_mode() {
    case "$1" in
        NATIVE|SOFTWARE)
            ;;
        *)
            die "unsupported SHA_ACCEL_MODE=$1; supported: NATIVE SOFTWARE"
            ;;
    esac
}

build_sim() {
    case "$1" in
        simx)
            run_cmd env CCACHE_DISABLE=1 make -C "$ROOT_DIR/sim/simx" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        rtlsim)
            run_cmd env CCACHE_DISABLE=1 make -C "$ROOT_DIR/sim/rtlsim" clean all "DEBUG=$DEBUG_LEVEL"
            ;;
        *)
            die "unsupported driver: $1"
            ;;
    esac
}

main() {
    DRIVER_LIST="simx,rtlsim"
    ACCEL_MODE_LIST="NATIVE,SOFTWARE"
    STARTUP_ADDR=""
    EXT_F_DISABLE=0
    EXT_D_DISABLE=0
    DEBUG_LEVEL=0
    RESULTS="sha256-smoke-results.tsv"
    LOG_DIR="sha256-smoke-logs"
    INCLUDE_RTLSIM_NATIVE=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --drivers=*)
                DRIVER_LIST="${1#*=}"
                ;;
            --accel-modes=*)
                ACCEL_MODE_LIST="${1#*=}"
                ;;
            --results=*)
                RESULTS="${1#*=}"
                ;;
            --log-dir=*)
                LOG_DIR="${1#*=}"
                ;;
            --startup-addr=*)
                STARTUP_ADDR="${1#*=}"
                ;;
            --ext-f-disable)
                EXT_F_DISABLE=1
                ;;
            --ext-d-disable)
                EXT_D_DISABLE=1
                ;;
            --fd-disable)
                EXT_F_DISABLE=1
                EXT_D_DISABLE=1
                ;;
            --debug=*)
                DEBUG_LEVEL="${1#*=}"
                ;;
            --include-rtlsim-native)
                INCLUDE_RTLSIM_NATIVE=1
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
        shift
    done

    IFS=',' read -r -a DRIVERS <<< "$DRIVER_LIST"
    IFS=',' read -r -a ACCEL_MODES <<< "$ACCEL_MODE_LIST"

    local driver
    for driver in "${DRIVERS[@]}"; do
        validate_driver "$driver"
    done

    local mode
    for mode in "${ACCEL_MODES[@]}"; do
        validate_accel_mode "$mode"
    done

    if [[ ! -f "$ROOT_DIR/config.mk" ]]; then
        die "config.mk not found under $ROOT_DIR"
    fi

    XLEN=$(sed -n 's/^XLEN[[:space:]]*?=[[:space:]]*//p' "$ROOT_DIR/config.mk" | head -n1 | tr -d '[:space:]')
    if [[ -z "$XLEN" ]]; then
        die "failed to determine XLEN from $ROOT_DIR/config.mk"
    fi
    if [[ -z "$STARTUP_ADDR" ]]; then
        if [[ "$XLEN" == "64" ]]; then
            STARTUP_ADDR="0x180000000"
        else
            STARTUP_ADDR="0x80000000"
        fi
    fi

    if [[ -f "$ROOT_DIR/ci/toolchain_env.sh" ]]; then
        # shellcheck disable=SC1091
        source "$ROOT_DIR/ci/toolchain_env.sh"
    fi

    mkdir -p "$LOG_DIR"

    echo "ROOT_DIR=$ROOT_DIR"
    echo "XLEN=$XLEN"
    echo "DRIVERS=${DRIVERS[*]}"
    echo "ACCEL_MODES=${ACCEL_MODES[*]}"
    echo "RESULTS=$RESULTS"

    run_cmd make -C "$ROOT_DIR/hw" config

    local kernel_args=("make" "-C" "$ROOT_DIR/kernel" "clean" "all")
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && kernel_args+=("$flag")
    done < <(join_flags)
    run_cmd "${kernel_args[@]}"

    for driver in "${DRIVERS[@]}"; do
        build_sim "$driver"
    done

    printf 'algo\taccel_mode\tdriver\tstatus\tlog\n' > "$RESULTS"

    local app_dir="$ROOT_DIR/tests/kernel/sha256"
    local failures=0
    for mode in "${ACCEL_MODES[@]}"; do
        local build_args=("make" "-C" "$app_dir" "clean" "all" "XLEN=$XLEN" "STARTUP_ADDR=$STARTUP_ADDR" "SHA_ACCEL_MODE=$mode")
        while IFS= read -r flag; do
            [[ -n "$flag" ]] && build_args+=("$flag")
        done < <(join_flags)
        run_cmd "${build_args[@]}"

        for driver in "${DRIVERS[@]}"; do
            if [[ "$driver" == "rtlsim" && "$mode" == "NATIVE" && "$INCLUDE_RTLSIM_NATIVE" -ne 1 ]]; then
                printf 'sha256\t%s\t%s\tskipped-no-rtl\t\n' "$mode" "$driver" >> "$RESULTS"
                echo "== Skipping sha256 mode=$mode on rtlsim until SHA RTL is wired =="
                continue
            fi

            local log_file="$LOG_DIR/sha256-${mode}-${driver}.log"
            local status
            echo
            echo "== Running sha256 mode=$mode on $driver =="
            if make -C "$app_dir" "run-$driver" "SHA_ACCEL_MODE=$mode" 2>&1 | tee "$log_file"; then
                status="ok"
            else
                status="fail"
                failures=$((failures + 1))
            fi
            printf 'sha256\t%s\t%s\t%s\t%s\n' "$mode" "$driver" "$status" "$log_file" >> "$RESULTS"
        done
    done

    if [[ $failures -ne 0 ]]; then
        die "$failures SHA-256 smoke run(s) failed; partial results are in $RESULTS"
    fi

    echo "SHA-256 smoke results written to $RESULTS"
}

main "$@"
